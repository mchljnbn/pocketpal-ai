<?xml version="1.0" encoding="utf-8"?>
<!--
  Animated splash icon (Android 12+ only): the orb eases in from 86% to full
  size while the eyes blink once. Total run time is ~720ms; the theme sets
  windowSplashScreenAnimationDuration to 800.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_orb_face">

    <target android:name="orb_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.86"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:duration="700"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.86"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:duration="700"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="eyes_group">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.0"
                    android:valueTo="0.12"
                    android:valueType="floatType"
                    android:startOffset="420"
                    android:duration="90"
                    android:interpolator="@android:interpolator/fast_out_linear_in" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.12"
                    android:valueTo="1.0"
                    android:valueType="floatType"
                    android:duration="110"
                    android:interpolator="@android:interpolator/fast_out_slow_in" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
